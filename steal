#!/bin/bash
# steal: install packages with whatever this system has (paru/yay/pacman, apt,
# xbps, then Flatpak), install local package files, and download media URLs.

usage() {
    cat <<'EOF'
Usage: steal ARG [ARG ...]

  steal firefox gimp                   Native packages; names not found go to Flatpak
  steal org.gimp.GIMP                  Flatpak app ID
  steal app/org.gimp.GIMP/x86_64/stable
  steal ./app.deb ./tool.pkg.tar.zst   Local packages (.deb is converted with debtap on Arch)
  steal ./app.flatpakref               Flatpak ref or bundle, local file or URL
  steal URL [URL ...]                  Download with yt-dlp (max 1440p), falling back to gallery-dl
  steal URL1 URL2 /absolute/dir        A directory right after URLs is where those URLs go

Package managers: paru, yay, pacman (Arch/Artix), apt (Debian/Ubuntu), xbps (Void)
EOF
}

if [ $# -eq 0 ]; then
    usage
    exit 1
fi
case "$1" in
    -h|--help) usage; exit 0 ;;
esac

bold() { printf '\033[1m%s\033[0m\n' "$*"; }

downloads_folder=$(xdg-user-dir DOWNLOAD 2>/dev/null)
if [ -z "$downloads_folder" ] || [ "$downloads_folder" = "$HOME" ]; then
    downloads_folder="$HOME/Downloads"
fi

priv() {
    if [ "$EUID" -eq 0 ]; then
        "$@"
    elif command -v doas >/dev/null 2>&1; then
        doas "$@"
    else
        sudo "$@"
    fi
}

# AUR helpers refuse to run as root, so root falls back to plain pacman
detect_package_manager() {
    if command -v pacman >/dev/null 2>&1; then
        if [ "$EUID" -ne 0 ] && command -v paru >/dev/null 2>&1; then
            echo paru
        elif [ "$EUID" -ne 0 ] && command -v yay >/dev/null 2>&1; then
            echo yay
        else
            echo pacman
        fi
    elif command -v apt-get >/dev/null 2>&1; then
        echo apt
    elif command -v xbps-install >/dev/null 2>&1; then
        echo xbps
    else
        echo none
    fi
}

PKG_MANAGER=$(detect_package_manager)
if [ "$PKG_MANAGER" = none ]; then
    echo "Warning: no supported package manager found (paru, yay, pacman, apt, xbps); package names go straight to Flatpak." >&2
fi

# Resolvable from the repos (or the AUR), counting groups and provides
pkg_available() {
    case "$PKG_MANAGER" in
        paru|yay)
            pacman -Sp --noconfirm --print-format %n "$1" >/dev/null 2>&1 || "$PKG_MANAGER" -Si "$1" >/dev/null 2>&1 ;;
        pacman)
            pacman -Sp --noconfirm --print-format %n "$1" >/dev/null 2>&1 ;;
        apt)
            apt-get -s install "$1" >/dev/null 2>&1 ;;
        xbps)
            xbps-query -R "$1" >/dev/null 2>&1 ;;
        *)
            return 1 ;;
    esac
}

pkg_installed() {
    case "$PKG_MANAGER" in
        paru|yay|pacman)
            pacman -T "$1" >/dev/null 2>&1 || pacman -Qg "$1" >/dev/null 2>&1 ;;
        apt)
            dpkg-query -W -f '${Status}' "$1" 2>/dev/null | grep -q 'ok installed' ;;
        xbps)
            xbps-query "$1" >/dev/null 2>&1 ;;
        *)
            return 1 ;;
    esac
}

install_packages() {
    case "$PKG_MANAGER" in
        paru)   paru -S --skipreview --needed "$@" ;;
        yay)    yay -S --needed "$@" ;;
        pacman) priv pacman -S --needed --noconfirm "$@" ;;
        apt)    priv apt-get install -y "$@" ;;
        xbps)   priv xbps-install -y "$@" ;;
        *)      return 1 ;;
    esac
}

# A full -Syu on Arch: syncing without upgrading is a partial upgrade
sync_database() {
    case "$PKG_MANAGER" in
        paru|yay) "$PKG_MANAGER" -Syu ;;
        pacman)   priv pacman -Syu ;;
        apt)      priv apt-get update ;;
        xbps)     priv xbps-install -S ;;
        *)        return 1 ;;
    esac
}

is_url()          { [[ $1 =~ ^https?:// ]]; }
is_arch_pkg()     { [[ $1 =~ \.pkg\.tar(\.(zst|xz|gz))?$ ]]; }
is_deb()          { [[ $1 =~ \.u?deb$ ]]; }
is_flatpak_file() { [[ $1 =~ \.flatpak(ref)?$ ]]; }

FAILED=()
fail() {
    echo "$1" >&2
    shift
    FAILED+=("$@")
}

# Local files are resolved to absolute paths up front so relative paths survive any cd
add_file() {
    local -n list="$1"
    local path
    if path=$(realpath -e -- "$2" 2>/dev/null) && [ -f "$path" ]; then
        list+=("$path")
    else
        fail "File not found: $2" "$2"
    fi
}

download_urls=()
download_dests=()
pending_urls=()
flush_pending() {
    local u
    for u in "${pending_urls[@]}"; do
        download_urls+=("$u")
        download_dests+=("$1")
    done
    pending_urls=()
}

native_packages=()
flatpak_packages=()
flatpak_files=()
deb_files=()
pkg_files=()

for arg in "$@"; do
    if is_url "$arg"; then
        if [[ $arg =~ \.flatpakref$ ]]; then
            flush_pending "$downloads_folder"
            flatpak_files+=("$arg")
        else
            pending_urls+=("$arg")
        fi
        continue
    fi

    if [ ${#pending_urls[@]} -gt 0 ] && [[ $arg == /* ]] && [ ! -f "$arg" ] \
        && ! is_arch_pkg "$arg" && ! is_deb "$arg" && ! is_flatpak_file "$arg"; then
        flush_pending "$arg"
        continue
    fi
    flush_pending "$downloads_folder"

    if is_arch_pkg "$arg"; then
        add_file pkg_files "$arg"
    elif is_deb "$arg"; then
        add_file deb_files "$arg"
    elif is_flatpak_file "$arg"; then
        add_file flatpak_files "$arg"
    elif [[ $arg == */* ]]; then
        # repo/package (extra/firefox) on Arch, otherwise a Flatpak ref
        if [[ $PKG_MANAGER =~ ^(paru|yay|pacman)$ ]] && pkg_available "$arg"; then
            native_packages+=("$arg")
        else
            flatpak_packages+=("$arg")
        fi
    else
        native_packages+=("$arg")
    fi
done
flush_pending "$downloads_folder"

# Media downloads
if [ ${#download_urls[@]} -gt 0 ]; then
    # Separate video+audio streams need ffmpeg to merge; without it take single-file formats
    if command -v ffmpeg >/dev/null 2>&1; then
        format='bv*[height<=?1440]+ba/b[height<=?1440]/bv*+ba/b'
    else
        format='b[height<=?1440]/b'
    fi
    for i in "${!download_urls[@]}"; do
        url="${download_urls[$i]}"
        dest="${download_dests[$i]}"
        bold "Downloading $url -> $dest"
        if ! mkdir -p "$dest"; then
            fail "Cannot create $dest" "$url"
            continue
        fi
        if command -v yt-dlp >/dev/null 2>&1 \
            && yt-dlp -f "$format" -o "$dest/%(title)s.%(ext)s" "$url"; then
            echo "Downloaded $url with yt-dlp"
        elif command -v gallery-dl >/dev/null 2>&1 && { echo "Trying gallery-dl..."; gallery-dl -d "$dest" "$url"; }; then
            echo "Downloaded $url with gallery-dl"
        else
            fail "Could not download $url with yt-dlp or gallery-dl" "$url"
        fi
    done
fi

# Local Arch packages, one transaction so they can satisfy each other's dependencies
if [ ${#pkg_files[@]} -gt 0 ]; then
    case "$PKG_MANAGER" in
        paru|yay)
            bold "Installing package files with $PKG_MANAGER"
            "$PKG_MANAGER" -U --noconfirm "${pkg_files[@]}" || fail "Failed to install ${pkg_files[*]}" "${pkg_files[@]}" ;;
        pacman)
            bold "Installing package files with pacman"
            priv pacman -U --noconfirm "${pkg_files[@]}" || fail "Failed to install ${pkg_files[*]}" "${pkg_files[@]}" ;;
        *)
            fail "Skipping ${#pkg_files[@]} Arch package file(s): pacman is not available" "${pkg_files[@]}" ;;
    esac
fi

# Native packages: names the repos (or AUR) don't know go to Flatpak
flatpak_fallback=()
if [ ${#native_packages[@]} -gt 0 ]; then
    if [ "$PKG_MANAGER" = none ]; then
        flatpak_packages+=("${native_packages[@]}")
    else
        found=()
        for p in "${native_packages[@]}"; do
            if pkg_available "$p"; then
                found+=("$p")
            else
                echo "$p: not found by $PKG_MANAGER, trying Flatpak"
                flatpak_packages+=("$p")
            fi
        done

        if [ ${#found[@]} -gt 0 ]; then
            bold "Installing with $PKG_MANAGER: ${found[*]}"
            err_log=$(mktemp)
            install_packages "${found[@]}" 2> >(tee "$err_log" >&2)
            rc=$?
            wait $! 2>/dev/null

            if [ $rc -ne 0 ] && grep -qiE 'failed retrieving|failed to (retrieve|fetch|download)|download.*failed|unable to fetch|could not resolve|temporary failure|connection|timed? ?out|network|mirror|404|database' "$err_log"; then
                echo "Network or database error, syncing and retrying..."
                if sync_database; then
                    install_packages "${found[@]}"
                    rc=$?
                fi
            fi
            rm -f "$err_log"

            # Anything that still isn't installed (failed build, declined prompt) is offered from Flatpak
            if [ $rc -ne 0 ]; then
                for p in "${found[@]}"; do
                    pkg_installed "$p" || flatpak_fallback+=("$p")
                done
            fi
        fi
    fi
fi

# Flatpak
if [ ${#flatpak_packages[@]} -gt 0 ] || [ ${#flatpak_fallback[@]} -gt 0 ] || [ ${#flatpak_files[@]} -gt 0 ]; then
    if command -v flatpak >/dev/null 2>&1; then
        bold "Installing with Flatpak"
        for p in "${flatpak_packages[@]}" "${flatpak_files[@]}"; do
            flatpak install -y "$p" || fail "Flatpak could not install $p" "$p"
        done
        # Not -y: these failed natively, possibly because the prompt was declined
        for p in "${flatpak_fallback[@]}"; do
            flatpak install "$p" || fail "Neither $PKG_MANAGER nor Flatpak installed $p" "$p"
        done
    else
        for p in "${flatpak_packages[@]}" "${flatpak_fallback[@]}" "${flatpak_files[@]}"; do
            fail "Flatpak is not installed, skipping $p" "$p"
        done
    fi
fi

debtap_db_ready() {
    compgen -G '/var/cache/pkgfile/*.files' >/dev/null \
        && compgen -G '/var/cache/debtap/*-packages-files' >/dev/null \
        && [ -e /var/cache/debtap/extended-base-packages-list ] \
        && [ -e /var/cache/debtap/aur-packages ] \
        && [ -e /var/cache/debtap/virtual-packages ]
}

convert_and_install_deb() {
    local deb="$1" work pkg
    work=$(mktemp -d "${XDG_CACHE_HOME:-$HOME/.cache}/steal-debtap.XXXXXX") || return 1
    cp -- "$deb" "$work/" || return 1
    if ! (cd "$work" && priv debtap -q "${deb##*/}"); then
        echo "debtap output kept in $work" >&2
        return 1
    fi
    pkg=$(find "$work" -maxdepth 1 \( -name '*.pkg.tar.zst' -o -name '*.pkg.tar.xz' \) -print -quit)
    if [ -n "$pkg" ] && priv pacman -U --noconfirm "$pkg"; then
        priv rm -rf -- "$work"
        return 0
    fi
    echo "debtap output kept in $work" >&2
    return 1
}

# .deb files
if [ ${#deb_files[@]} -gt 0 ]; then
    case "$PKG_MANAGER" in
        apt)
            bold "Installing .deb files with apt"
            for deb in "${deb_files[@]}"; do
                if priv apt-get install -y "$deb"; then
                    echo "Installed $deb"
                else
                    echo "apt-get failed, trying dpkg -i and fixing dependencies..."
                    if priv dpkg -i "$deb" && priv apt-get install -f -y; then
                        echo "Installed $deb"
                    else
                        priv apt-get install -f -y
                        fail "Failed to install $deb" "$deb"
                    fi
                fi
            done
            ;;
        paru|yay|pacman)
            bold "Converting .deb files with debtap"
            if ! command -v debtap >/dev/null 2>&1; then
                for deb in "${deb_files[@]}"; do
                    fail "debtap is not installed, skipping $deb" "$deb"
                done
            else
                mkdir -p "${XDG_CACHE_HOME:-$HOME/.cache}"
                db_ok=true
                if ! debtap_db_ready; then
                    db_ok=false
                    for attempt in 1 2 3; do
                        echo "Updating debtap database (attempt $attempt/3)..."
                        if priv debtap -u; then
                            db_ok=true
                            break
                        fi
                        sleep 3
                    done
                fi
                for deb in "${deb_files[@]}"; do
                    if [ "$db_ok" != true ]; then
                        fail "debtap database could not be updated, skipping $deb" "$deb"
                    elif convert_and_install_deb "$deb"; then
                        echo "Installed $deb"
                    else
                        fail "Failed to convert or install $deb" "$deb"
                    fi
                done
            fi
            ;;
        *)
            for deb in "${deb_files[@]}"; do
                fail "No apt or pacman to install $deb" "$deb"
            done
            ;;
    esac
fi

if [ ${#FAILED[@]} -eq 0 ]; then
    bold "steal: PASS"
else
    bold "steal: FAIL (${#FAILED[@]}): ${FAILED[*]}"
    exit 1
fi
